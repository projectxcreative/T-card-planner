{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-card-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },

  // The custom domain is the only way in. Left undeclared, the *.workers.dev
  // and preview URLs stay open — a second, unprotected front door to the same
  // board that any Access policy on the domain would not cover.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "work.projectxcreative.com", "custom_domain": true }],

  // The built SPA. `single-page-application` sends unknown paths to index.html
  // so a refresh on any URL still loads the board.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Replace `id` with the namespace you create:
  //   npx wrangler kv namespace create BOARD
  "kv_namespaces": [
    {
      "binding": "BOARD",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
