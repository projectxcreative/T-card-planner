{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-card-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },

  // Keep the *.workers.dev and preview URLs shut, so the custom domain is the
  // only way in — otherwise the same board answers on a second address that no
  // Access policy on the domain would cover. The domain itself is attached in
  // the dashboard; declaring it here as well makes a CI deploy ask for
  // confirmation it cannot get, and fail.
  "workers_dev": false,
  "preview_urls": false,

  // Where the login lives, for reference — none of these are set here:
  //   ACCESS_TEAM_DOMAIN  your Zero Trust team, e.g. `myteam`
  //   ACCESS_AUD          the Access application's Audience tag
  //   ACCESS_EMAILS       optional: only these addresses, whatever the policy says
  // Put them on the Worker with `npx wrangler secret put …`, or in `.dev.vars`
  // for a local run. Set as vars here they would be committed, and a
  // placeholder left behind by accident silently switches the login off.

  // The built SPA. `single-page-application` sends unknown paths to index.html
  // so a refresh on any URL still loads the board.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    // Every request, not just the API: the Worker checks the Access login
    // before it hands over even the app shell, so a Worker reachable on some
    // address the Access application misses is still a closed door.
    "run_worker_first": true
  },

  // REQUIRED: the deploy fails until `id` is a real namespace id.
  //   npx wrangler kv namespace create BOARD
  "kv_namespaces": [
    {
      "binding": "BOARD",
      "id": "d7b525d76f024e30bff6b106ef9b6ec5"    }
  ]
}
