{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-card-planner-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "demo.planner.projectxcreative.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "BOARD_KEY": "demo-board",
    "DEMO_MODE": "true"
  },
  "kv_namespaces": [{
    "binding": "BOARD",
    "id": "d7b525d76f024e30bff6b106ef9b6ec5"
  }]
}
